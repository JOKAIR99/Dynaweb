{
  "name": "dynaweb-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Dynaweb Studio: a visual website generator with a structured site model and an animation designer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
